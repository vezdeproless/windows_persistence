<!-- Merge these rules into /var/ossec/etc/rules/local_rules.xml. -->
<group name="windows,persistence,registry,">
  <rule id="110500" level="5">
    <decoded_as>json</decoded_as>
    <field name="event.module">windows-persistence-detection</field>
    <field name="event.dataset">windows.registry.persistence</field>
    <description>Windows persistence registry artifact: $(reg.key.path) $(file.path)</description>
  </rule>

  <rule id="110501" level="8">
    <if_sid>110500</if_sid>
    <field name="threat.technique.id">T1547/001|T1546/010|T1053/005|T1543/003</field>
    <description>Windows autostart or scheduled persistence artifact: $(reg.key.path) $(file.path)</description>
  </rule>

  <rule id="110502" level="10">
    <if_sid>110500</if_sid>
    <field name="threat.technique.id">T1546/008|T1546/011|T1546/012|T1556/002|T1556/008|T1505/005</field>
    <description>High-risk Windows persistence artifact: $(reg.key.path) $(file.path)</description>
  </rule>
</group>
